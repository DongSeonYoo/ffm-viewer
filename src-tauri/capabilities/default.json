{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimum permissions for opening local documents and safe external links.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-hide",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "opener:allow-open-url"
  ]
}
