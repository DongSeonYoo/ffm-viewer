{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FFM Viewer",
  "version": "0.4.0",
  "identifier": "io.github.dongseonyoo.ffm-viewer",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FFM Viewer",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "width": 1040,
        "height": 760,
        "minWidth": 540,
        "minHeight": 420,
        "devtools": false,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "shortDescription": "A fast local viewer for documents, data, and images",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "mimeType": "text/markdown",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["json"],
        "mimeType": "application/json",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["txt"],
        "mimeType": "text/plain",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["yaml", "yml"],
        "mimeType": "application/yaml",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["toml"],
        "mimeType": "application/toml",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["png"],
        "mimeType": "image/png",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["jpg", "jpeg"],
        "mimeType": "image/jpeg",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["gif"],
        "mimeType": "image/gif",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["webp"],
        "mimeType": "image/webp",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["avif"],
        "mimeType": "image/avif",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["svg"],
        "mimeType": "image/svg+xml",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ]
  }
}
